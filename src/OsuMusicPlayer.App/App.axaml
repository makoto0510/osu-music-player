<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsuMusicPlayer.App.App"
             RequestedThemeVariant="Dark">
  <!-- Default palette (osu! Pink). ApplicationThemeApplier rewrites these when the user picks a theme. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://OsuMusicPlayer.App/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#0F0D14" />
      <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#16131D" />
      <SolidColorBrush x:Key="ThemeSurfaceAltBrush" Color="#252030" />
      <SolidColorBrush x:Key="ThemeBorderBrush" Color="#2B2536" />
      <SolidColorBrush x:Key="ThemeTextBrush" Color="#F2F3F7" />
      <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="#AEB4C4" />
      <SolidColorBrush x:Key="ThemeTextFaintBrush" Color="#737A8D" />
      <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FF66AA" />
      <SolidColorBrush x:Key="ThemeAccentTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ThemeAccentSoftBrush" Color="#33FF66AA" />
      <SolidColorBrush x:Key="ThemeSelectionBrush" Color="#40FF66AA" />
      <SolidColorBrush x:Key="ThemeButtonBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ThemeButtonHoverBrush" Color="#E8E8EC" />
      <SolidColorBrush x:Key="ThemeButtonTextBrush" Color="#14141A" />

      <!-- Sidebar navigation entry: a flat, rounded row that lights up when checked. -->
      <ControlTheme x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Background" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Background">
          <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Border#PART_Background">
          <Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextFaintBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextFaintBrush}" />
      <Setter Property="Margin" Value="20,14,0,4" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.4" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.column">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextFaintBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.accent">
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>

    <Style Selector="PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
    </Style>
    <Style Selector="PathIcon.muted">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>
    <Style Selector="PathIcon.faint">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextFaintBrush}" />
    </Style>
    <Style Selector="PathIcon.accent">
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="20,14" />
      <Setter Property="Margin" Value="16,0,16,10" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.badge.accent">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>
    <Style Selector="Border.kbd">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,1" />
    </Style>
    <Style Selector="Border.kbd TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextFaintBrush}" />
    </Style>
    <Style Selector="Border.thumb">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button, ToggleButton">
      <Setter Property="Background" Value="{DynamicResource ThemeButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeButtonTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter, ToggleButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeButtonTextBrush}" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.small, ToggleButton.small">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- Flat icon buttons (header tools, transport, row actions) -->
    <Style Selector="Button.icon, ToggleButton.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter, ToggleButton.icon:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
    </Style>
    <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.icon:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
    <Style Selector="Button.icon PathIcon, ToggleButton.icon PathIcon, Button.ghost PathIcon, Button.pill PathIcon">
      <Setter Property="Foreground" Value="{Binding $parent[ContentPresenter].Foreground}" />
    </Style>
    <Style Selector="Button.icon.small, ToggleButton.icon.small">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.icon.small PathIcon, ToggleButton.icon.small PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Button.icon.large, ToggleButton.icon.large">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="Button.icon.large PathIcon, ToggleButton.icon.large PathIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <!-- Row heart: invisible until hovered or favourited -->
    <Style Selector="Button.icon.heart">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextFaintBrush}" />
    </Style>
    <Style Selector="Button.icon.heart.on">
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>

    <!-- The big round play button -->
    <Style Selector="Button.play">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="CornerRadius" Value="23" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}" />
    </Style>
    <Style Selector="Button.play:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.play:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Button.play PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}" />
    </Style>

    <!-- Outlined pill (header filter) -->
    <Style Selector="Button.pill, ToggleButton.pill">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
    <Style Selector="Button.pill.active">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
    </Style>

    <!-- Quiet text buttons ("Clear") -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
    </Style>

    <!-- Window caption buttons -->
    <Style Selector="Button.caption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123" />
    </Style>
    <Style Selector="Button.caption.close:pointerover PathIcon">
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Search box -->
    <Style Selector="TextBox.search">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    </Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Track table rows -->
    <Style Selector="ListBox.tracks">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.tracks ListBoxItem">
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="ListBox.tracks ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
    </Style>
    <Style Selector="ListBox.tracks ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
    </Style>
    <Style Selector="ListBox.tracks ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
    </Style>
    <Style Selector="ListBox.tracks ListBoxItem:selected:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
    </Style>

    <!-- Compact lists (queue, difficulties) -->
    <Style Selector="ListBox.compact">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.compact ListBoxItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBox.compact ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
    </Style>
    <Style Selector="ListBox.compact ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
    </Style>
    <Style Selector="ListBox.compact ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
    </Style>

    <!-- Slim sliders (seek, volume) -->
    <Style Selector="Slider.slim">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="Slider.slim /template/ Thumb">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style Selector="MenuItem PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>
  </Application.Styles>
</Application>
