<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:audio="using:OsuMusicPlayer.Audio"
        xmlns:vm="using:OsuMusicPlayer.App.ViewModels"
        xmlns:input="using:OsuMusicPlayer.App.Input"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        xmlns:controls="using:OsuMusicPlayer.App.Controls"
        xmlns:local="using:OsuMusicPlayer.App"
        xmlns:models="using:OsuMusicPlayer.Core.Models"
        x:Class="OsuMusicPlayer.App.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="osu! music player"
        Width="1280" Height="820" MinWidth="1000" MinHeight="640"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource ThemeBackgroundBrush}">

  <Window.Resources>
    <!-- Row menu ("…" button and right-click). Every item acts on the selected track, which the row selects first. -->
    <MenuFlyout x:Key="TrackMenu" Placement="BottomEdgeAlignedRight">
      <MenuItem Header="Play" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PlaySelectedCommand}">
        <MenuItem.Icon><PathIcon Data="{StaticResource IconPlay}" /></MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Play from preview point" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PreviewSelectedCommand}">
        <MenuItem.Icon><PathIcon Data="{StaticResource IconEye}" /></MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Add to queue" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EnqueueSelectedCommand}">
        <MenuItem.Icon><PathIcon Data="{StaticResource IconQueue}" /></MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).FavouriteButtonText}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleFavouriteCommand}">
        <MenuItem.Icon><PathIcon Data="{StaticResource IconHeartOutline}" /></MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Header="Add to playlist" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Playlists}"
                IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Playlists.Count}">
        <MenuItem.Icon><PathIcon Data="{StaticResource IconPlaylistPlus}" /></MenuItem.Icon>
        <MenuItem.Styles>
          <Style Selector="MenuItem > MenuItem" x:DataType="vm:PlaylistViewModel">
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddSelectedToPlaylistCommand}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
          </Style>
        </MenuItem.Styles>
      </MenuItem>
      <MenuItem Header="Remove from this playlist" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveFromPlaylistCommand}"
                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsPlaylistViewSelected}">
        <MenuItem.Icon><PathIcon Data="{StaticResource IconTrash}" /></MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Move up" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MoveTrackUpCommand}"
                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsPlaylistViewSelected}">
        <MenuItem.Icon><PathIcon Data="{StaticResource IconArrowUp}" /></MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Move down" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MoveTrackDownCommand}"
                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsPlaylistViewSelected}">
        <MenuItem.Icon><PathIcon Data="{StaticResource IconArrowDown}" /></MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Header="Preview play (difficulty)" Command="{Binding $parent[local:MainWindow].OpenDifficultyPreviewCommand}">
        <MenuItem.Icon><PathIcon Data="{StaticResource IconTarget}" /></MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Open on osu! web" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenOnWebCommand}"
                IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanOpenOnWeb}">
        <MenuItem.Icon><PathIcon Data="{StaticResource IconOpenInNew}" /></MenuItem.Icon>
      </MenuItem>
    </MenuFlyout>

    <!-- Sort menu under the "Sorted by …" caption -->
    <MenuFlyout x:Key="SortMenu" Placement="BottomEdgeAlignedLeft">
      <MenuItem Header="Title" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetSortCommand}" CommandParameter="{x:Static vm:TrackSortOption.Title}" />
      <MenuItem Header="Artist" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetSortCommand}" CommandParameter="{x:Static vm:TrackSortOption.Artist}" />
      <MenuItem Header="BPM" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetSortCommand}" CommandParameter="{x:Static vm:TrackSortOption.BPM}" />
      <MenuItem Header="Length" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetSortCommand}" CommandParameter="{x:Static vm:TrackSortOption.Length}" />
      <MenuItem Header="Star rating" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetSortCommand}" CommandParameter="{x:Static vm:TrackSortOption.Stars}" />
      <MenuItem Header="Recently played" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetSortCommand}" CommandParameter="{x:Static vm:TrackSortOption.RecentlyPlayed}" />
      <MenuItem Header="Most played" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetSortCommand}" CommandParameter="{x:Static vm:TrackSortOption.MostPlayed}" />
    </MenuFlyout>

    <!-- Ruleset filter -->
    <MenuFlyout x:Key="ModeMenu" Placement="BottomEdgeAlignedLeft">
      <MenuItem Header="All modes" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetModeFilterCommand}" CommandParameter="{x:Null}" />
      <MenuItem Header="osu!" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetModeFilterCommand}" CommandParameter="{x:Static models:OsuRuleset.Osu}" />
      <MenuItem Header="osu!taiko" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetModeFilterCommand}" CommandParameter="{x:Static models:OsuRuleset.Taiko}" />
      <MenuItem Header="osu!catch" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetModeFilterCommand}" CommandParameter="{x:Static models:OsuRuleset.Catch}" />
      <MenuItem Header="osu!mania" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetModeFilterCommand}" CommandParameter="{x:Static models:OsuRuleset.Mania}" />
    </MenuFlyout>

    <!-- Sidebar entry -->
    <DataTemplate x:Key="NavEntry" x:DataType="vm:LibraryView">
      <RadioButton Theme="{StaticResource NavItem}" GroupName="library-nav" IsChecked="{Binding IsSelected, Mode=OneWay}"
                   Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectViewCommand}" CommandParameter="{Binding}"
                   ToolTip.Tip="{Binding DisplayName}">
        <Grid ColumnDefinitions="26,*,Auto">
          <PathIcon Grid.Column="0" Data="{Binding IconKey, Converter={x:Static local:IconKeyConverter.Instance}}" Classes="muted" Width="15" Height="15" HorizontalAlignment="Left" />
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="hint" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
      </RadioButton>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ===== Header: logo · search · filter · tools · window buttons ===== -->
    <Border x:Name="TitleBar" Grid.Row="0" Height="66" Padding="{Binding #Root.TitleBarPadding}" Background="{DynamicResource ThemeBackgroundBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <!-- Logo -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,20,0">
          <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource ThemeAccentBrush}">
            <Border Width="22" Height="22" CornerRadius="11" BorderBrush="White" BorderThickness="3" Background="{DynamicResource ThemeSurfaceBrush}" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <TextBlock FontSize="17" FontWeight="Bold">
              <Run Text="osu-" /><Run Text="music" Foreground="{DynamicResource ThemeAccentBrush}" /><Run Text="-player" />
            </TextBlock>
            <TextBlock Text="music for a brighter tomorrow." Classes="hint" FontSize="10" Margin="0,-2,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- Search -->
        <TextBox Grid.Column="1" x:Name="SearchBox" Classes="search" MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                 Watermark="Search songs, artists, mappers, or tags…"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip.Tip="{Binding SearchHelpText}">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource IconSearch}" Classes="faint" Margin="12,0,2,0" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Border Classes="kbd" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="/" /></Border>
          </TextBox.InnerRightContent>
        </TextBox>

        <!-- Ruleset filter -->
        <Button Grid.Column="2" Classes="pill" Classes.active="{Binding IsModeFilterActive}" Flyout="{StaticResource ModeMenu}" AutomationProperties.Name="Game mode filter" AutomationProperties.AutomationId="ModeFilterButton" Margin="18,0,10,0" VerticalAlignment="Center" ToolTip.Tip="Show only one game mode">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconFilter}" Width="14" Height="14" />
            <TextBlock Text="{Binding ModeFilterText}" />
          </StackPanel>
        </Button>

        <!-- Tools -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <ToggleButton Classes="icon" IsChecked="{Binding IsBrowsePanelVisible, Mode=TwoWay}" ToolTip.Tip="Browse artists, mappers and tags">
            <PathIcon Data="{StaticResource IconMusicNote}" />
          </ToggleButton>
          <ToggleButton Classes="icon" IsChecked="{Binding IsEqualizerPanelVisible, Mode=TwoWay}" ToolTip.Tip="Equalizer">
            <PathIcon Data="{StaticResource IconTune}" />
          </ToggleButton>
          <ToggleButton Classes="icon" IsChecked="{Binding IsSourcesPanelVisible, Mode=TwoWay}" ToolTip.Tip="Library sources (osu! folders)">
            <PathIcon Data="{StaticResource IconFolder}" />
          </ToggleButton>
          <ToggleButton Classes="icon" IsChecked="{Binding IsSettingsPanelVisible, Mode=TwoWay}" ToolTip.Tip="Settings (Ctrl+,)">
            <PathIcon Data="{StaticResource IconCog}" />
          </ToggleButton>
        </StackPanel>

        <!-- Window buttons (custom chrome on Windows / Linux) -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top" Margin="14,4,0,0" IsVisible="{Binding #Root.ShowWindowButtons}">
          <Button Classes="caption" x:Name="MinimizeButton" ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize"><PathIcon Data="{StaticResource IconMinimize}" /></Button>
          <Button Classes="caption" x:Name="MaximizeButton" ToolTip.Tip="Maximize" AutomationProperties.Name="Maximize"><PathIcon x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" /></Button>
          <Button Classes="caption close" x:Name="CloseButton" ToolTip.Tip="Close" AutomationProperties.Name="Close"><PathIcon Data="{StaticResource IconClose}" /></Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Body: sidebar | list | now playing ===== -->
    <Grid Grid.Row="1" Margin="0,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding SidebarColumnWidth}" />
        <ColumnDefinition Width="{Binding ListColumnWidth}" />
        <ColumnDefinition Width="{Binding DetailsColumnWidth}" />
      </Grid.ColumnDefinitions>

      <!-- ===== Sidebar ===== -->
      <Border Grid.Column="0" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="16" Margin="12,0,0,0" ClipToBounds="True" IsVisible="{Binding !IsTheaterMode}">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding LibraryViews}" ItemTemplate="{StaticResource NavEntry}" />

              <Border Height="1" Background="{DynamicResource ThemeBorderBrush}" Margin="20,10" />

              <!-- Quick sorts -->
              <RadioButton Theme="{StaticResource NavItem}" GroupName="quick-sort" IsChecked="{Binding IsSortRecentlyPlayed, Mode=OneWay}" Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:TrackSortOption.RecentlyPlayed}" ToolTip.Tip="Sort by last played">
                <Grid ColumnDefinitions="26,*"><PathIcon Data="{StaticResource IconHistory}" Classes="muted" Width="15" Height="15" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="Recently Played" FontSize="13" /></Grid>
              </RadioButton>
              <RadioButton Theme="{StaticResource NavItem}" GroupName="quick-sort" IsChecked="{Binding IsSortMostPlayed, Mode=OneWay}" Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:TrackSortOption.MostPlayed}" ToolTip.Tip="Sort by play count">
                <Grid ColumnDefinitions="26,*"><PathIcon Data="{StaticResource IconChartBar}" Classes="muted" Width="15" Height="15" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="Most Played" FontSize="13" /></Grid>
              </RadioButton>
              <RadioButton Theme="{StaticResource NavItem}" GroupName="quick-sort" IsChecked="{Binding IsSortStars, Mode=OneWay}" Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:TrackSortOption.Stars}" ToolTip.Tip="Sort by star rating">
                <Grid ColumnDefinitions="26,*"><PathIcon Data="{StaticResource IconStarOutline}" Classes="muted" Width="15" Height="15" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="Top Rated" FontSize="13" /></Grid>
              </RadioButton>

              <Border Height="1" Background="{DynamicResource ThemeBorderBrush}" Margin="20,10" />

              <!-- Playlists -->
              <Grid ColumnDefinitions="*,Auto" Margin="20,4,12,2">
                <TextBlock Grid.Column="0" Classes="section" Text="PLAYLISTS" Margin="0" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Classes="icon small" IsChecked="{Binding IsPlaylistPanelVisible, Mode=TwoWay}" ToolTip.Tip="New playlist / manage playlists">
                  <PathIcon Data="{StaticResource IconPlus}" />
                </ToggleButton>
              </Grid>

              <!-- Playlist management -->
              <StackPanel Margin="16,4,16,8" Spacing="6" IsVisible="{Binding IsPlaylistPanelVisible}">
                <TextBox Watermark="New playlist name" Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}" FontSize="12" />
                <Button Classes="small primary" Content="Create playlist" Command="{Binding CreatePlaylistCommand}" HorizontalAlignment="Stretch" />
                <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}" PlaceholderText="Playlist to edit…" HorizontalAlignment="Stretch" FontSize="12">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistViewModel">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <UniformGrid Columns="2">
                  <Button Classes="small" Content="Rename" Command="{Binding RenamePlaylistCommand}" HorizontalAlignment="Stretch" Margin="0,0,3,0" ToolTip.Tip="Renames the chosen playlist to the name typed above" />
                  <Button Classes="small" Content="Delete" Command="{Binding DeletePlaylistCommand}" HorizontalAlignment="Stretch" Margin="3,0,0,0" />
                </UniformGrid>
                <Button Classes="small" Content="Save search as smart playlist" Command="{Binding CreateSmartPlaylistCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Turns the current search text (e.g. tag:anime bpm:>180) into a live playlist" />
                <Button Classes="small" Content="Delete this smart playlist" Command="{Binding DeleteSmartPlaylistCommand}" HorizontalAlignment="Stretch" IsVisible="{Binding IsSmartPlaylistViewSelected}" />
                <Button Classes="small" Content="Export view as collection.db…" Command="{Binding ExportViewAsCollectionCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Writes the listed tracks as an osu!stable collection file (outside the osu! folder)" />
              </StackPanel>

              <ItemsControl ItemsSource="{Binding PlaylistViews}" ItemTemplate="{StaticResource NavEntry}" />
              <TextBlock IsVisible="{Binding !HasPlaylistViews}" Classes="hint" Text="No playlists yet — press + to create one." Margin="20,2,16,6" />

              <!-- osu! collections -->
              <StackPanel IsVisible="{Binding HasCollectionViews}">
                <TextBlock Classes="section" Text="OSU! COLLECTIONS" Margin="20,14,0,4" />
                <ItemsControl ItemsSource="{Binding CollectionViews}" ItemTemplate="{StaticResource NavEntry}" />
              </StackPanel>
              <Border Height="8" />
            </StackPanel>
          </ScrollViewer>

          <!-- Library card -->
          <Border Grid.Row="1" Margin="12,6,12,12" Height="74" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource ThemeSurfaceAltBrush}">
            <Grid>
              <Image Source="{Binding CurrentTrack.BackgroundImage^}" Stretch="UniformToFill" Opacity="0.55" />
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#D00F0D14" Offset="0" />
                    <GradientStop Color="#400F0D14" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <StackPanel VerticalAlignment="Center" Margin="14,0" Spacing="2">
                <TextBlock Classes="eyebrow" Text="LIBRARY" />
                <TextBlock Text="{Binding LibraryStatusText}" FontSize="11.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="White" ToolTip.Tip="{Binding LibraryStatusText}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ===== Centre: tool drawer + track table ===== -->
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" Margin="12,0,12,0" ClipToBounds="True" IsVisible="{Binding !IsTheaterMode}">

        <!-- Tool drawer -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="400">
          <StackPanel>

            <!-- Sources -->
            <Border Classes="panel" Margin="0,0,0,10" IsVisible="{Binding IsSourcesPanelVisible}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Library sources" Classes="title" />
                    <TextBlock Classes="hint" Text="osu! folders are only ever read. Add a folder manually when automatic detection fails." />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="small" Content="Add osu!stable folder…" Command="{Binding AddStableFolderCommand}" IsVisible="{Binding CanAddStableFolder}" />
                    <Button Classes="small" Content="Add osu!lazer folder…" Command="{Binding AddLazerFolderCommand}" />
                    <Button Classes="small" Content="Reload" Command="{Binding ReloadLibraryCommand}" />
                  </StackPanel>
                </Grid>
                <TextBlock IsVisible="{Binding !HasInstallations}" Text="No osu! installation was detected on this computer." Classes="accent" />
                <ItemsControl ItemsSource="{Binding Installations}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstallationItemViewModel">
                      <Grid ColumnDefinitions="70,*,90,Auto" ColumnSpacing="12" Margin="0,2">
                        <Border Grid.Column="0" Classes="badge" HorizontalAlignment="Left" Margin="0"><TextBlock Text="{Binding KindText}" /></Border>
                        <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                        <TextBlock Grid.Column="2" Text="{Binding OriginText}" Classes="hint" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Classes="small" Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding IsManual}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Browse -->
            <Border Classes="panel" Margin="0,0,0,10" IsVisible="{Binding IsBrowsePanelVisible}">
              <StackPanel Spacing="6">
                <TextBlock Text="Browse" Classes="title" />
                <TextBlock Text="Artists" FontWeight="SemiBold" Classes="muted" />
                <ItemsControl ItemsSource="{Binding TopArtists}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BrowseEntry">
                      <Button Classes="chip" Content="{Binding DisplayName}" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectBrowseCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Mappers" FontWeight="SemiBold" Classes="muted" />
                <ItemsControl ItemsSource="{Binding TopMappers}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BrowseEntry">
                      <Button Classes="chip" Content="{Binding DisplayName}" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectBrowseCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Tags" FontWeight="SemiBold" Classes="muted" />
                <ItemsControl ItemsSource="{Binding TopTags}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BrowseEntry">
                      <Button Classes="chip" Content="{Binding DisplayName}" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectBrowseCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Equalizer -->
            <Border Classes="panel" Margin="0,0,0,10" IsVisible="{Binding IsEqualizerPanelVisible}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Top" Width="190">
                  <TextBlock Text="Equalizer" Classes="title" />
                  <TextBlock Classes="hint" Text="Ten-band peaking EQ (BASS_FX). Presets or your own curve, saved automatically." />
                  <ComboBox ItemsSource="{Binding EqualizerPresetNames}" SelectedItem="{Binding SelectedEqualizerPreset, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="{Binding EqualizerPresetText}" />
                  <Button Classes="small" Content="Reset to flat" Command="{Binding ResetEqualizerCommand}" />
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding EqualizerBands}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EqualizerBandViewModel">
                      <StackPanel Width="52" Spacing="2">
                        <TextBlock Text="{Binding GainText}" FontSize="10" Classes="muted" HorizontalAlignment="Center" />
                        <Slider Orientation="Vertical" Height="100" Minimum="-12" Maximum="12" TickFrequency="1" Value="{Binding Gain, Mode=TwoWay}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>

            <!-- Settings -->
            <Border Classes="panel" Margin="0,0,0,10" IsVisible="{Binding IsSettingsPanelVisible}">
              <TabControl Padding="0,8,0,0">
                <TabItem Header="Appearance">
                  <StackPanel Spacing="8" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Classes="hint" Text="Pick a preset, then optionally type any accent colour (hex) to match your osu! skin. Changes apply immediately and are saved." />
                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme" Classes="muted" VerticalAlignment="Center" />
                      <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding SelectedThemeName, Mode=TwoWay}" Width="220" HorizontalAlignment="Left" />
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Accent colour" Classes="muted" VerticalAlignment="Center" />
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBox Width="140" Watermark="#FF66AA" Text="{Binding AccentColorText, UpdateSourceTrigger=PropertyChanged}" />
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" />
                        <Button Classes="small" Content="Reset" Command="{Binding ResetAccentColorCommand}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AccentColorStatusText}" Classes="hint" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Preview skin" Classes="muted" VerticalAlignment="Center" ToolTip.Tip="Skin used by the difficulty preview window" />
                      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{Binding PreviewSkinNames}" SelectedItem="{Binding SelectedPreviewSkinName, Mode=TwoWay}" Width="220" />
                        <Button Classes="small" Content="Refresh" Command="{Binding RefreshPreviewSkinsCommand}" VerticalAlignment="Center" ToolTip.Tip="Re-scan the skin folders" />
                        <Button Classes="small" Content="Open folder" Command="{Binding OpenSkinsFolderCommand}" VerticalAlignment="Center" ToolTip.Tip="{Binding SkinsFolderPath}" />
                      </StackPanel>
                      <CheckBox Grid.Row="3" Grid.Column="1" Content="Use the skin's combo colours instead of the beatmap's" IsChecked="{Binding PreferSkinComboColours, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="{Binding SkinsFolderPath, StringFormat='Put skin folders (osu! format: skin.ini + PNG elements) in {0}. Skins installed in osu!stable are listed too.'}" TextWrapping="Wrap" />
                    <TextBlock Classes="hint" Text="{Binding PreviewSkinStatusText}" IsVisible="{Binding PreviewSkinStatusText.Length}" TextWrapping="Wrap" />
                  </StackPanel>
                </TabItem>
                <TabItem Header="Hit sounds">
                  <StackPanel Width="360" Spacing="6" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="90,*,60" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="Volume" Classes="muted" VerticalAlignment="Center" />
                      <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding HitsoundVolume, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding HitsoundVolume, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*,60" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="Offset" Classes="muted" VerticalAlignment="Center" ToolTip.Tip="Positive plays hit sounds later" />
                      <Slider Grid.Column="1" Minimum="-200" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding HitsoundOffsetMs, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding HitsoundOffsetText}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Turn hit sounds on with the headphones toggle in the now-playing pane. The selected difficulty provides the samples." />
                  </StackPanel>
                </TabItem>
                <TabItem Header="Library">
                  <StackPanel Width="420" Spacing="6" HorizontalAlignment="Left">
                    <TextBlock Classes="hint" Text="Hide sets by length or by a search query (e.g. mode:mania, tag:tv, artist:x). Applies on Reload too." />
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Min length (s)" Classes="muted" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="36000" Increment="10" FormatString="0" Value="{Binding ExcludeMinLengthSeconds, Mode=TwoWay}" />
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Max length (s)" Classes="muted" VerticalAlignment="Center" ToolTip.Tip="0 = no limit" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="36000" Increment="10" FormatString="0" Value="{Binding ExcludeMaxLengthSeconds, Mode=TwoWay}" />
                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Exclude query" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Row="2" Grid.Column="1" Watermark="mode:mania -tag:keep" Text="{Binding ExcludeQueryText, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Button Classes="small" Content="Apply exclusions" Command="{Binding ApplyExclusionsCommand}" />
                      <TextBlock Text="{Binding ExclusionStatusText}" Classes="hint" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </TabItem>
                <TabItem Header="Server / OBS">
                  <StackPanel Width="460" Spacing="6" HorizontalAlignment="Left">
                    <TextBlock Classes="hint" Text="Serves the library, audio streams, a web remote (/) and an OBS browser-source overlay (/overlay) over HTTP." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <CheckBox Content="Enabled" IsChecked="{Binding IsServerEnabled, Mode=TwoWay}" />
                      <TextBlock Text="Port" Classes="muted" VerticalAlignment="Center" />
                      <NumericUpDown Minimum="1024" Maximum="65535" Increment="1" FormatString="0" Value="{Binding ServerPort, Mode=TwoWay}" Width="120" />
                      <CheckBox Content="Allow LAN" IsChecked="{Binding ServerAllowRemote, Mode=TwoWay}" ToolTip.Tip="Off: only this computer can connect" />
                    </StackPanel>
                    <TextBlock Text="{Binding ServerStatusText}" Classes="hint" />
                    <TextBlock Classes="hint" Text="OBS: add a Browser source with the overlay URL above (e.g. 800×160, transparent background)." />
                  </StackPanel>
                </TabItem>
                <TabItem Header="Discord">
                  <StackPanel Width="420" Spacing="6" HorizontalAlignment="Left">
                    <TextBlock Classes="hint" Text="Create an application at discord.com/developers and paste its Application ID." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <CheckBox Content="Enabled" IsChecked="{Binding IsRichPresenceEnabled, Mode=TwoWay}" />
                      <TextBox Width="220" Watermark="Application ID" Text="{Binding DiscordApplicationId, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding RichPresenceStatusText}" Classes="hint" />
                  </StackPanel>
                </TabItem>
                <TabItem Header="osu! API">
                  <StackPanel Width="420" Spacing="6" HorizontalAlignment="Left">
                    <TextBlock Classes="hint" Text="OAuth client from osu.ppy.sh/home/account/edit → OAuth. Used only to read beatmap set genre and language." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBox Width="110" Watermark="Client ID" Text="{Binding OsuApiClientId, Mode=TwoWay}" />
                      <TextBox Width="200" Watermark="Client secret" PasswordChar="•" Text="{Binding OsuApiClientSecret, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Button Classes="small" Content="Fetch metadata" Command="{Binding FetchOnlineMetadataCommand}" />
                      <TextBlock Text="{Binding OnlineMetadataStatusText}" Classes="hint" VerticalAlignment="Center" MaxWidth="260" />
                    </StackPanel>
                  </StackPanel>
                </TabItem>
                <TabItem Header="Shortcuts">
                  <ItemsControl ItemsSource="{Binding Shortcuts}" MaxHeight="300">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Vertical" MaxHeight="300" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="input:Shortcut">
                        <Grid ColumnDefinitions="150,220" Margin="0,1,24,1">
                          <Border Grid.Column="0" Classes="badge" HorizontalAlignment="Left" Margin="0,0,8,0"><TextBlock Text="{Binding GestureText}" /></Border>
                          <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </TabItem>
              </TabControl>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- List header -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="8,2,8,0">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{Binding ViewTitle}" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding TrackCountText}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" />
              <TextBlock Text="•" Classes="hint" FontSize="12.5" VerticalAlignment="Center" />
              <Button Classes="ghost" Flyout="{StaticResource SortMenu}" Padding="4,1" AutomationProperties.Name="Sort" AutomationProperties.AutomationId="SortButton" ToolTip.Tip="Sort order (playlists keep their own order)">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <TextBlock Text="{Binding SortLabelText}" FontSize="12.5" />
                  <PathIcon Data="{StaticResource IconChevronDown}" Width="13" Height="13" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
            <ToggleButton Classes="small" Content="DT" IsChecked="{Binding IsDtActive}" Command="{Binding SetModCommand}" CommandParameter="{x:Static audio:OsuAudioMod.DT}" ToolTip.Tip="Double Time" />
            <ToggleButton Classes="small" Content="NC" IsChecked="{Binding IsNcActive}" Command="{Binding SetModCommand}" CommandParameter="{x:Static audio:OsuAudioMod.NC}" ToolTip.Tip="Nightcore" />
            <ToggleButton Classes="small" Content="HT" IsChecked="{Binding IsHtActive}" Command="{Binding SetModCommand}" CommandParameter="{x:Static audio:OsuAudioMod.HT}" ToolTip.Tip="Half Time" />
            <ToggleButton Classes="small" Content="DC" IsChecked="{Binding IsDcActive}" Command="{Binding SetModCommand}" CommandParameter="{x:Static audio:OsuAudioMod.DC}" ToolTip.Tip="Daycore" />
          </StackPanel>
        </Grid>

        <!-- Column captions -->
        <Grid Grid.Row="2" ColumnDefinitions="34,56,*,180,64,64,36,36" ColumnSpacing="10" Margin="8,14,12,6">
          <TextBlock Grid.Column="0" Classes="column" Text="#" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Classes="column" Text="TITLE" />
          <TextBlock Grid.Column="3" Classes="column" Text="ARTIST" />
          <TextBlock Grid.Column="4" Classes="column" Text="BPM" HorizontalAlignment="Right" />
          <PathIcon Grid.Column="5" Data="{StaticResource IconClock}" Classes="faint" Width="13" Height="13" HorizontalAlignment="Right" />
        </Grid>

        <!-- Track table -->
        <Grid Grid.Row="3">
          <ListBox x:Name="TrackList" Classes="tracks" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" Padding="0,0,4,8">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TrackItemViewModel">
                <Grid ColumnDefinitions="34,56,*,180,64,64,36,36" Height="56" ColumnSpacing="10" Background="Transparent" ContextFlyout="{StaticResource TrackMenu}">
                  <TextBlock Grid.Column="0" Text="{Binding Position}" Classes="muted" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="thumb" Width="46" Height="46">
                    <Grid>
                      <PathIcon Data="{StaticResource IconMusicNote}" Classes="faint" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Source="{Binding BackgroundImage^}" Stretch="UniformToFill" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CreatorText}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding Artist}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Artist}" />
                  <TextBlock Grid.Column="4" Text="{Binding BpmValueText}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="5" Text="{Binding LengthText}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
                  <Button Grid.Column="6" Classes="icon small heart" Classes.on="{Binding IsFavourite}" VerticalAlignment="Center"
                          Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ToggleFavouriteForCommand}" CommandParameter="{Binding}" ToolTip.Tip="Favourite (Ctrl+D)">
                    <Panel>
                      <PathIcon Data="{StaticResource IconHeartOutline}" IsVisible="{Binding !IsFavourite}" />
                      <PathIcon Data="{StaticResource IconHeart}" IsVisible="{Binding IsFavourite}" />
                    </Panel>
                  </Button>
                  <Button Grid.Column="7" Classes="icon small" VerticalAlignment="Center" Flyout="{StaticResource TrackMenu}" AutomationProperties.Name="More" AutomationProperties.AutomationId="RowMenuButton"
                          Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).SelectTrackCommand}" CommandParameter="{Binding}" ToolTip.Tip="More">
                    <PathIcon Data="{StaticResource IconDots}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="True" VerticalAlignment="Top" Height="3" />
          <TextBlock IsVisible="{Binding !HasTracks}" Text="{Binding EmptyStateText}" Classes="hint" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" TextAlignment="Center" />
        </Grid>
      </Grid>

      <!-- ===== Now playing pane ===== -->
      <Border Grid.Column="2" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="16" Margin="0,0,12,0" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="{Binding VisualRowHeight}" />
            <RowDefinition Height="{Binding DetailsRowHeight}" />
          </Grid.RowDefinitions>

          <!-- Cover: background image with the storyboard and video layered on top -->
          <Border Grid.Row="0" Margin="14,14,14,0" CornerRadius="14" Background="Black" ClipToBounds="True">
            <Grid>
              <PathIcon Data="{StaticResource IconMusicNote}" Classes="faint" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image Source="{Binding DetailTrack.LargeBackgroundImage^}" Stretch="UniformToFill" />
              <controls:StoryboardView x:Name="StoryboardView" Session="{Binding StoryboardSession}" IsVisible="{Binding ShowStoryboardInPane}" />
              <vlc:VideoView x:Name="VideoView" Height="{Binding VideoSurfaceHeight}" IsVisible="{Binding ShowVideoInPane}" VerticalAlignment="Stretch" />
              <Border IsVisible="{Binding IsVisualsPoppedOut}" Background="#88000000" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Padding="12,6">
                <TextBlock Text="Visuals are shown in their own window" FontSize="12" Foreground="White" />
              </Border>
              <!-- Visual controls float over the cover -->
              <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8" CornerRadius="10" Background="#99000000" Padding="4,2">
                <StackPanel Orientation="Horizontal" Spacing="0">
                  <ToggleButton Classes="icon small" IsChecked="{Binding IsVideoEnabled, Mode=TwoWay}" IsEnabled="{Binding IsVideoAvailable}" ToolTip.Tip="{Binding VideoToggleTip}"><PathIcon Data="{StaticResource IconVideo}" /></ToggleButton>
                  <ToggleButton Classes="icon small" IsChecked="{Binding IsStoryboardEnabled, Mode=TwoWay}" ToolTip.Tip="Storyboard"><PathIcon Data="{StaticResource IconStoryboard}" /></ToggleButton>
                  <ToggleButton Classes="icon small" IsChecked="{Binding IsHitsoundEnabled, Mode=TwoWay}" ToolTip.Tip="Hit sounds from the selected difficulty"><PathIcon Data="{StaticResource IconHeadphones}" /></ToggleButton>
                  <Button Classes="icon small" Command="{Binding #Root.ToggleVisualsWindowCommand}" ToolTip.Tip="{Binding VisualsWindowButtonText}"><PathIcon Data="{StaticResource IconPictureInPicture}" /></Button>
                  <Button Classes="icon small" Command="{Binding #Root.FullscreenVisualsCommand}" ToolTip.Tip="Fullscreen (F11)"><PathIcon Data="{StaticResource IconFullscreen}" /></Button>
                  <ToggleButton Classes="icon small" IsChecked="{Binding IsTheaterMode, Mode=TwoWay}" ToolTip.Tip="Theater mode (Ctrl+T)" AutomationProperties.Name="Theater mode" AutomationProperties.AutomationId="TheaterToggle"><PathIcon Data="{StaticResource IconTheater}" /></ToggleButton>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- Details -->
          <Grid Grid.Row="1" IsVisible="{Binding IsDetailsPaneVisible}">
            <TextBlock IsVisible="{Binding !HasDetailTrack}" Text="Select a track to see it here" Classes="hint" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasDetailTrack}">
              <StackPanel Margin="18,14,18,16" Spacing="10">

                <!-- Now playing -->
                <ContentControl Content="{Binding DetailTrack}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:TrackItemViewModel">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="eyebrow" Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NowPlayingLabel}" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                          <Button Grid.Column="1" Classes="icon heart" Classes.on="{Binding IsFavourite}" VerticalAlignment="Top" Margin="6,-4,-6,0"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleFavouriteCommand}" ToolTip.Tip="Favourite (Ctrl+D)">
                            <Panel>
                              <PathIcon Data="{StaticResource IconHeartOutline}" IsVisible="{Binding !IsFavourite}" Width="20" Height="20" />
                              <PathIcon Data="{StaticResource IconHeart}" IsVisible="{Binding IsFavourite}" Width="20" Height="20" />
                            </Panel>
                          </Button>
                        </Grid>
                        <TextBlock Text="{Binding Artist}" Classes="muted" FontSize="13.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CreatorText}" Classes="hint" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- Position (only for the playing track) -->
                <StackPanel Spacing="2" IsVisible="{Binding IsDetailCurrent}">
                  <Slider Classes="slim" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=TwoWay}" Margin="-6,0" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding CurrentTimeText}" Classes="hint" />
                    <TextBlock Grid.Column="1" Text="{Binding TotalTimeText}" Classes="hint" />
                  </Grid>
                </StackPanel>

                <!-- Badges / tags -->
                <ContentControl Content="{Binding DetailTrack}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:TrackItemViewModel">
                      <StackPanel Spacing="2">
                        <WrapPanel Orientation="Horizontal">
                          <Border Classes="chip"><TextBlock Text="{Binding SourceText}" /></Border>
                          <Border Classes="chip"><TextBlock Text="{Binding StarText}" /></Border>
                          <Border Classes="chip"><TextBlock Text="{Binding DifficultyCountText}" /></Border>
                          <Border Classes="chip"><TextBlock Text="{Binding BpmText}" /></Border>
                          <Border Classes="chip" IsVisible="{Binding HasOnlineMetadata}"><TextBlock Text="{Binding OnlineMetadataText}" /></Border>
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding TagChips}" IsVisible="{Binding HasTagChips}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Border Classes="chip"><TextBlock Text="{Binding}" Foreground="{DynamicResource ThemeAccentBrush}" /></Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Classes="icon" Command="{Binding PlaySelectedCommand}" ToolTip.Tip="Play (Enter)"><PathIcon Data="{StaticResource IconPlay}" /></Button>
                  <Button Classes="icon" Command="{Binding PreviewSelectedCommand}" ToolTip.Tip="{Binding DetailTrack.PreviewTimeText, StringFormat='Play from the preview point ({0})'}"><PathIcon Data="{StaticResource IconEye}" /></Button>
                  <Button Classes="icon" Command="{Binding EnqueueSelectedCommand}" ToolTip.Tip="Add to queue (Ctrl+E)"><PathIcon Data="{StaticResource IconQueue}" /></Button>
                  <Button Classes="icon" Command="{Binding #Root.OpenDifficultyPreviewCommand}" AutomationProperties.Name="Difficulty preview" AutomationProperties.AutomationId="DifficultyPreviewButton" ToolTip.Tip="Preview play of the selected difficulty (Ctrl+Shift+P)"><PathIcon Data="{StaticResource IconTarget}" /></Button>
                  <Button Classes="icon" Command="{Binding OpenOnWebCommand}" IsEnabled="{Binding CanOpenOnWeb}" ToolTip.Tip="Open on osu.ppy.sh"><PathIcon Data="{StaticResource IconOpenInNew}" /></Button>
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                  <ComboBox Grid.Column="0" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}" PlaceholderText="Add to playlist…" HorizontalAlignment="Stretch" FontSize="12" MinHeight="30">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PlaylistViewModel">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Classes="icon" Command="{Binding AddToPlaylistCommand}" ToolTip.Tip="Add to the chosen playlist"><PathIcon Data="{StaticResource IconPlaylistPlus}" /></Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsPlaylistViewSelected}">
                  <Button Classes="small" Content="Remove from playlist" Command="{Binding RemoveFromPlaylistCommand}" />
                  <Button Classes="icon small" Command="{Binding MoveTrackUpCommand}" ToolTip.Tip="Move up"><PathIcon Data="{StaticResource IconArrowUp}" /></Button>
                  <Button Classes="icon small" Command="{Binding MoveTrackDownCommand}" ToolTip.Tip="Move down"><PathIcon Data="{StaticResource IconArrowDown}" /></Button>
                </StackPanel>
                <TextBlock Text="{Binding VisualsStatusText}" Classes="hint" IsVisible="{Binding VisualsStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Up next -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                  <TextBlock Grid.Column="0" Text="Up Next" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Content="Clear" Command="{Binding ClearQueueCommand}" IsVisible="{Binding HasQueue}" />
                </Grid>
                <TextBlock IsVisible="{Binding !HasQueue}" Classes="hint" Text="Nothing queued. Queued tracks play next, before shuffle or list order." />
                <ItemsControl ItemsSource="{Binding Queue}" Margin="-8,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackItemViewModel">
                      <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,4"
                              Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).PlayQueuedCommand}" CommandParameter="{Binding}" ToolTip.Tip="Play now">
                        <Grid ColumnDefinitions="38,*,Auto,Auto" ColumnSpacing="10">
                          <Border Grid.Column="0" Classes="thumb" Width="36" Height="36" CornerRadius="6">
                            <Image Source="{Binding BackgroundImage^}" Stretch="UniformToFill" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Text="{Binding Artist}" Classes="hint" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding LengthText}" Classes="hint" VerticalAlignment="Center" />
                          <Button Grid.Column="3" Classes="icon small" VerticalAlignment="Center" ToolTip.Tip="Remove from queue"
                                  Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveFromQueueCommand}" CommandParameter="{Binding}">
                            <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                          </Button>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Difficulties -->
                <ContentControl Content="{Binding DetailTrack}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:TrackItemViewModel">
                      <StackPanel Spacing="6" Margin="0,6,0,0">
                        <TextBlock Text="Difficulties" FontSize="15" FontWeight="Bold" />
                        <TextBlock Classes="hint" Text="The selected difficulty provides the hit sounds, the storyboard and the play preview." />
                        <!-- AutoScrollToSelectedItem is off so the pane opens at the top even though the hardest difficulty is preselected. -->
                        <ListBox Classes="compact" ItemsSource="{Binding Difficulties}" SelectedItem="{Binding SelectedDifficulty, Mode=TwoWay}" AutoScrollToSelectedItem="False" Margin="-8,0">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DifficultyItemViewModel">
                              <Grid ColumnDefinitions="5,Auto,*,Auto" ColumnSpacing="9">
                                <Border Grid.Column="0" Width="5" CornerRadius="3" Background="{Binding StarColor}" />
                                <Border Grid.Column="1" Classes="badge" Margin="0" VerticalAlignment="Center"><TextBlock Text="{Binding RulesetText}" FontSize="10" /></Border>
                                <StackPanel Grid.Column="2" Spacing="1">
                                  <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding StatsText}" Classes="hint" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding StarText}" FontSize="12" VerticalAlignment="Center" Foreground="{Binding StarColor}" FontWeight="SemiBold" />
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== Player bar ===== -->
    <Border Grid.Row="2" Padding="16,10,16,10" Margin="0,10,0,0" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="300,*,300" ColumnSpacing="16">

        <!-- Current track -->
        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="56,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
          <Border Classes="thumb" Width="56" Height="56" CornerRadius="10">
            <Grid>
              <PathIcon Data="{StaticResource IconMusicNote}" Classes="faint" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image Source="{Binding CurrentTrack.BackgroundImage^}" Stretch="UniformToFill" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='Nothing playing'}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentTrack.Title}" />
            <TextBlock Text="{Binding CurrentTrack.Artist}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border IsVisible="{Binding HasVideo}" Classes="badge accent" Margin="0" Padding="5,1"><TextBlock Text="VIDEO" FontSize="9" /></Border>
              <Border IsVisible="{Binding HasStoryboard}" Classes="badge accent" Margin="0" Padding="5,1"><TextBlock Text="STORYBOARD" FontSize="9" /></Border>
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="2" Classes="icon heart" Classes.on="{Binding IsDetailFavourite}" VerticalAlignment="Center" Command="{Binding ToggleFavouriteCommand}" ToolTip.Tip="Favourite (Ctrl+D)">
            <Panel>
              <PathIcon Data="{StaticResource IconHeartOutline}" IsVisible="{Binding !IsDetailFavourite}" Width="18" Height="18" />
              <PathIcon Data="{StaticResource IconHeart}" IsVisible="{Binding IsDetailFavourite}" Width="18" Height="18" />
            </Panel>
          </Button>
        </Grid>

        <!-- Transport -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <ToggleButton Classes="icon" IsChecked="{Binding IsShuffleEnabled, Mode=TwoWay}" ToolTip.Tip="Shuffle (Ctrl+S)"><PathIcon Data="{StaticResource IconShuffle}" /></ToggleButton>
          <Button Classes="icon large" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous (Ctrl+←)"><PathIcon Data="{StaticResource IconSkipPrevious}" /></Button>
          <Button Classes="play" Command="{Binding TogglePlayCommand}" ToolTip.Tip="Play / pause (Space)" AutomationProperties.Name="Play / pause" AutomationProperties.AutomationId="PlayPauseButton">
            <Panel>
              <PathIcon Data="{StaticResource IconPlay}" IsVisible="{Binding !IsPlaying}" Margin="2,0,0,0" />
              <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding IsPlaying}" />
            </Panel>
          </Button>
          <Button Classes="icon large" Command="{Binding NextCommand}" ToolTip.Tip="Next (Ctrl+→)"><PathIcon Data="{StaticResource IconSkipNext}" /></Button>
          <ToggleButton Classes="icon" IsChecked="{Binding IsRepeatOn, Mode=OneWay}" Command="{Binding CycleRepeatCommand}" ToolTip.Tip="{Binding RepeatText}">
            <Panel>
              <PathIcon Data="{StaticResource IconRepeat}" IsVisible="{Binding !IsRepeatOne}" />
              <PathIcon Data="{StaticResource IconRepeatOnce}" IsVisible="{Binding IsRepeatOne}" />
            </Panel>
          </ToggleButton>
        </StackPanel>
        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="44,*,44" ColumnSpacing="8" Margin="0,2,0,0">
          <TextBlock Grid.Column="0" Text="{Binding CurrentTimeText}" Classes="hint" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <Slider Grid.Column="1" Classes="slim" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=TwoWay}" />
          <TextBlock Grid.Column="2" Text="{Binding TotalTimeText}" Classes="hint" FontSize="11.5" VerticalAlignment="Center" />
        </Grid>

        <!-- Volume / panes -->
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
          <Border Classes="badge accent" Margin="0,0,6,0" Padding="7,2" VerticalAlignment="Center" ToolTip.Tip="Active mod"><TextBlock Text="{Binding ModText}" FontSize="10" FontWeight="Bold" /></Border>
          <PathIcon Data="{StaticResource IconVolume}" Classes="muted" IsVisible="{Binding !IsMuted}" Margin="0,0,4,0" />
          <PathIcon Data="{StaticResource IconVolumeOff}" Classes="muted" IsVisible="{Binding IsMuted}" Margin="0,0,4,0" />
          <Slider Classes="slim" Width="110" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" ToolTip.Tip="Volume (Ctrl+↑ / Ctrl+↓)" />
          <Button Classes="icon" Command="{Binding #Root.ToggleVisualsWindowCommand}" ToolTip.Tip="Video / storyboard in its own window (Ctrl+P)" Margin="6,0,0,0"><PathIcon Data="{StaticResource IconPictureInPicture}" /></Button>
          <ToggleButton Classes="icon" IsChecked="{Binding IsNowPlayingPaneVisible, Mode=TwoWay}" ToolTip.Tip="Now playing / queue pane (Ctrl+Q)"><PathIcon Data="{StaticResource IconPlaylist}" /></ToggleButton>
        </StackPanel>

        <!-- Errors -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" IsVisible="{Binding HasError}" Background="#3B1D27" CornerRadius="8" Padding="10,4" Margin="0,4,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB6C8" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="700" ToolTip.Tip="{Binding ErrorMessage}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
