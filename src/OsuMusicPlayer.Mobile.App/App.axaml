<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsuMusicPlayer.Mobile.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Control">
      <Setter Property="TextElement.FontFamily" Value="Noto Sans CJK JP" />
    </Style>
  </Application.Styles>
</Application>

